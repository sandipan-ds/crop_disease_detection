# ─── Environment / Secrets (NEVER commit) ───
.env

# ─── Data (too large for git) ───
business_objective/
data/

# ─── Model weights ───
models/saved/*.pth
models/saved/*.pt
models/saved/*.onnx
!models/saved/.gitkeep

# ─── Python ───
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ─── IDE ───
.vscode/
.idea/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Jupyter ───
.ipynb_checkpoints/

# ─── Logs & Reports ───
*.log
reports/*.png
reports/*.html
!reports/.gitkeep

# ─── Training artifacts (TensorBoard, logs, checkpoints) ───
runs/

# ─── Binary / serialized ML artifacts (cache, weights, datasets) ───
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.ckpt
*.bin

# ─── Editor temp / backup files ───
*.swp
*.swo
*~
*.bak

# ─── GCP credentials (NEVER commit) ───
scripts/*.json

# ─── Large CSVs (generated, not source) ───
notebook/train.csv
notebook/test.csv

# ─── Temp files from label encoding cell ───
notebook/label_encoding_cell.py

# ─── GCS Service Account Key (NEVER commit) ───
gcs_service_key/

# Project Documentation
project_document/

