# ─── Environment / Secrets (NEVER commit) ───
.env

# ─── Data & project docs (too large / unnecessary for git) ───
project_document/

# Raw source datasets — never commit, never DVC-track (too large / external)
data/original/

# Processed datasets and CSVs — DVC manages content, Git tracks .dvc recipes
data/processed/*
!data/processed/*.dvc
data/csv/*
!data/csv/*.dvc

# ─── Model weights ───
models/saved/*.pth
models/saved/*.pt
models/saved/*.onnx
!models/saved/.gitkeep

# ─── Python ───
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ─── IDE ───
.vscode/
.idea/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Jupyter ───
.ipynb_checkpoints/

# ─── Logs & Reports ───
*.log
reports/*.png
reports/*.html
!reports/.gitkeep

# ─── Training artifacts (TensorBoard, logs, checkpoints) ───
runs/

# ─── Binary / serialized ML artifacts (cache, weights, datasets) ───
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5
*.hdf5
*.ckpt
*.bin

# ─── Editor temp / backup files ───
*.swp
*.swo
*~
*.bak

# ─── GCP credentials (NEVER commit) ───
scripts/*.json

# ─── Temp files from label encoding cell ───
notebook/label_encoding_cell.py

# ─── TensorBoard logs ───
runs/

# ─── Jupyter checkpoints ───
.ipynb_checkpoints/

# ─── Models ───
models/

# ─── GCS Service Key ───
gcs_service_key/

# Results folder — model checkpoints, GradCAM images, evaluation artifacts
# (DVC-managed via results.dvc at project root; Git ignores folder contents)
results/

# ─── Frontend build artifacts ───
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ─── Deployment artifacts ───
env.yaml
*.tar.gz

# ─── Firebase (CLI handles these) ───
.firebase/
.firebaserc
firebase-debug.log
firestore-debug.log
ui-debug.log

# ─── Caches ───
*.cache/
.pytest_cache/
.mypy_cache/

# ─── Test coverage ───
htmlcov/
.coverage
