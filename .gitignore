# ─── Environment / Secrets (NEVER commit) ───
.env

# ─── Data (too large for git) ───
business_objective/
data/

# ─── Model weights ───
models/saved/*.pth
models/saved/*.pt
models/saved/*.onnx
!models/saved/.gitkeep

# ─── Python ───
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ─── IDE ───
.vscode/
.idea/

# ─── OS ───
.DS_Store
Thumbs.db

# ─── Jupyter ───
.ipynb_checkpoints/

# ─── Logs & Reports ───
*.log
reports/*.png
reports/*.html
!reports/.gitkeep

# ─── GCP credentials (NEVER commit) ───
scripts/*.json

# ─── Large CSVs (generated, not source) ───
notebook/train.csv
notebook/test.csv

# ─── Temp files from label encoding cell ───
notebook/label_encoding_cell.py

# ─── TensorBoard logs ───
runs/

# ─── Jupyter checkpoints ───
.ipynb_checkpoints/

# ─── Models ───
models/
